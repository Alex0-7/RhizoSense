# RhizoSense Backend Environment Variables

# Host to bind the Uvicorn server to
# Local: 127.0.0.1 (or 0.0.0.0)
HOST=0.0.0.0

# Port to run the server on (Render automatically provides $PORT)
PORT=8000

# Allowed CORS origins (comma-separated or * for any)
# Local: *
# Production example: https://rhizosense.vercel.app,http://localhost:5173
CORS_ORIGINS=*
