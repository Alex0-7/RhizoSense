# RhizoSense Frontend Environment Variables

# Base URL for the FastAPI REST API
# Local development default: http://127.0.0.1:8000/api
# Production (Render) example: https://rhizosense-backend.onrender.com/api
VITE_API_URL=http://127.0.0.1:8000/api

# Base URL for the WebSocket real-time event stream
# (Optional: if omitted, RhizoSense automatically derives the wss:// URL from VITE_API_URL)
# Local development default: ws://127.0.0.1:8000/ws
# Production (Render) example: wss://rhizosense-backend.onrender.com/ws
VITE_WS_URL=ws://127.0.0.1:8000/ws
